# Build output
# Prefixo **/ e obrigatorio: no .dockerignore "obj/" casa so com a raiz, e os obj/
# do host (com caminhos Windows no project.assets.json) quebram o build no container.
**/bin/
**/obj/
**/out/

# Visual Studio
.vs/
**/*.suo
**/*.user

# NuGet — nuget.config entra na imagem de proposito, para o restore no container
# usar as mesmas fontes do restore local.
packages/

# Docker
.dockerignore
Dockerfile
docker-compose.yml

# Git
.git/
.gitignore
.github/

# Logs
*.log
logs/

# Test results
TestResults/
*.trx
*.coverage

# IDE
.vscode/
.idea/

# Frontend: nao entra na imagem da API
src/SolarSystem.Web/
**/node_modules/

# Arquivos do sistema
nul
Thumbs.db
Desktop.ini

# Coverage
coverage/
*.info
