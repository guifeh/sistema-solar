<?xml version="1.0" encoding="utf-8"?>
<!--
  Config no nivel do repositorio para o restore nao depender do NuGet.Config da maquina.
  Sem isto, um packageSourceMapping definido por outro projeto no mesmo usuario bloqueia
  qualquer pacote fora do allowlist dele.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
